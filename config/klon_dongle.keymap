#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include "zmk-helpers/helper.h"
#include "zmk-helpers/key-labels/36.h"

/ {
    behaviors {
        /* Left-hand HRMs. */

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 14 15 16 19 20 21 30 31 32 33 34 40 41 0 1 2 3 4 5 14 15 16 17 18 19 30 31 32 33 34 40 41 22 23 42 43>;
            hold-trigger-on-release;
        };

        /* Right-hand HRMs. */

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <8 9 10 11 12 13 22 23 24 25 26 27 28 29 35 36 37 38 39 42 43 21 20 41 40>;
            hold-trigger-on-release;
        };

        sh: sticky_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "SH";
            bindings = <&mo>, <&sl>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <0>;
            flavor = "tap-preferred";
        };
    };

    combos {
        compatible = "zmk,combos";

        par1 {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <3 4>;
            layers = <0>;
        };

        par2 {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <9 10>;
            layers = <0>;
        };

        cur1 {
            bindings = <&kp LEFT_BRACE>;
            key-positions = <32 33>;
            layers = <0>;
        };

        cur2 {
            bindings = <&kp RIGHT_BRACE>;
            key-positions = <37 36>;
            layers = <0>;
        };

        bracket1 {
            bindings = <&kp LEFT_BRACKET>;
            key-positions = <17 18>;
            layers = <0>;
        };

        bracket2 {
            bindings = <&kp RIGHT_BRACKET>;
            key-positions = <25 26>;
            layers = <0>;
        };

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <1 2>;
            layers = <0>;
        };

        quotes {
            bindings = <&kp SINGLE_QUOTE>;
            key-positions = <28 27>;
            layers = <0>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <25 26 27>;
            layers = <0>;
        };

        lower {
            bindings = <&mo 0>;
            key-positions = <37 36 38>;
            layers = <0>;
        };

        shift {
            bindings = <&kp LEFT_SHIFT>;
            key-positions = <18 17 16>;
            layers = <0>;
        };

        alt {
            bindings = <&kp LALT>;
            key-positions = <33 32 31>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        qwerty-base {
            bindings = <
&trans  &kp Q  &kp W         &kp E  &kp R     &kp T        &trans            &trans             &kp Y      &kp U    &kp I      &kp O         &kp P     &trans
&trans  &kp A  &hml LCTRL S  &kp D  &kp F     &kp G        &kp BSPC  &trans  &trans  &kp SPACE  &kp H      &kp J    &kp K      &hmr RCTRL L  &kp SEMI  &trans
        &kp Z  &kp X         &kp C  &kp V     &kp B                                             &kp N      &kp M    &kp COMMA  &kp DOT       &kp FSLH
                                    &kp LGUI  &lt 1 ENTER                                       &kp LSHFT  &sh 3 2
            >;

            sensor-bindings = <&inc_dec_kp A B &inc_dec_kp C D>;
        };

        num {
            bindings = <
&trans  &kp N1   &kp N2  &kp N3  &kp N4    &kp N5  &trans          &trans           &kp N6  &kp N7    &kp N8    &kp N9     &kp N0  &trans
&trans  &kp TAB  &trans  &trans  &kp LALT  &trans  &trans  &trans  &trans  &kp DEL  &trans  &trans    &kp UP    &trans     &trans  &trans
        &trans   &trans  &trans  &trans    &trans                                   &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans
                                 &trans    &trans                                   &trans  &trans
            >;
        };

        upper {
            bindings = <
&trans  &kp EXCLAMATION  &kp AT  &kp HASH  &kp DOLLAR  &kp PERCENT  &trans          &trans          &kp CARET  &kp AMPERSAND  &kp ASTERISK  &trans     &trans  &trans
&trans  &trans           &trans  &trans    &trans      &trans       &trans  &trans  &trans  &trans  &kp MINUS  &kp EQUAL      &kp BSLH      &kp GRAVE  &trans  &trans
        &trans           &trans  &trans    &trans      &trans                                       &kp UNDER  &kp PLUS       &kp PIPE      &kp TILDE  &trans
                                           &trans      &trans                                       &trans     &trans
            >;
        };

        fn+nav {
            bindings = <
&trans  &kp F1   &kp F2   &kp F3  &kp F4  &kp F5       &trans          &trans          &kp F6       &kp F7    &kp F8    &kp F9     &kp F10  &trans
&trans  &kp F11  &kp F12  &trans  &trans  &bootloader  &trans  &trans  &trans  &trans  &bootloader  &trans    &kp UP    &trans     &trans   &trans
        &trans   &trans   &trans  &trans  &trans                                       &trans       &kp LEFT  &kp DOWN  &kp RIGHT  &trans
                                  &trans  &trans                                       &trans       &trans
            >;
        };
    };
};
